{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wuqiong-travel",
  "account_id": "d533ce3cc36dd35fbf18273d2db0d264",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wuqiong-travel",
      "database_id": "a16f9442-c457-4ef8-b9d6-e082ae7b6efb",
      // wrangler 會在 D1 建 d1_migrations 表記錄已套用的檔案，
      // 之後不論在哪台電腦都是 `wrangler d1 migrations apply wuqiong-travel --remote`，
      // 可安全重複執行，不會重跑或漏跑。
      "migrations_dir": "server/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "wuqiong-travel-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // 行程頁「下載 PDF」用。需要先在 Cloudflare Dashboard 開通 Browser Rendering
  // （付費功能，依用量計費）才能在正式環境使用，本機 wrangler dev 無法模擬，
  // 要測試得用 `wrangler dev --remote` 或直接對已部署的環境測。
  "browser": {
    "binding": "BROWSER"
  }
}
